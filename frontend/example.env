# ─────────────────────────────────────────────────────────────────────────────
# Synthetic People — frontend environment (Vite)
#
# For local development copy this to .env.local, NOT .env:
#
#   cp example.env .env.local        (bash)
#   Copy-Item example.env .env.local (PowerShell)
#
# frontend/.env is committed and is what the Docker image is built with, so it
# must keep pointing at the deployed API. .env.local overrides it and is
# gitignored.
#
# Vite inlines every VITE_* value into the JavaScript bundle at build time.
# Anything here is public — never put secrets in this file.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API origin, no trailing slash and no /api suffix.
# Local backend: http://localhost:8000
# Staging:       https://staging-api.synthetic-people.ai
VITE_BACKEND_URL=http://localhost:8000

# Default request timeout (ms).
VITE_API_TIMEOUT=30000

# Timeout for long-running report downloads (ms).
VITE_REPORT_TIMEOUT=960000

# Exposed as API_CONFIG.ENABLE_DEBUG (src/config/apiConfig.js); nothing reads it yet.
VITE_ENABLE_DEBUG=false
