# ─────────────────────────────────────────────────────────────────────────────
# Synthetic People — backend environment
#
#   cp example.env .env        (bash)
#   Copy-Item example.env .env (PowerShell)
#
# Loaded by app/config.py (pydantic-settings + python-dotenv) from the current
# working directory, so run uvicorn / alembic / pytest from backend/.
#
# Lines that are commented out are optional; the value shown is the default the
# code uses when the variable is unset. Never commit a real .env.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database (required) ──────────────────────────────────────────────────────
# Matches backend/docker-compose.yml. Keep the +asyncpg driver.
DATABASE_URL=postgresql+asyncpg://synth_user:synth_pass@localhost:5432/synthdb

# Emergency fallback only — schema comes from Alembic. Never true in production.
# RUN_STARTUP_MIGRATIONS=false
# Logs every SQL statement. Very slow; debugging only.
# SQLALCHEMY_ECHO=false


# ── Auth (required) ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=120
# Minutes of inactivity before a session is rejected.
# IDLE_TIMEOUT=60


# ── Superadmin bootstrap (required) ──────────────────────────────────────────
# Created on startup if missing. If the user already exists, its password is
# reset to SUPERADMIN_PASSWORD on every startup.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me


# ── Email / SMTP (required) ──────────────────────────────────────────────────
# Used for welcome, verification, password-reset and share emails.
# Note the variable names: MAIL_STARTTLS and MAIL_SSL_TLS (not MAIL_TLS / MAIL_SSL).
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Base URL of the web app; used to build links inside emails.
FRONTEND_URL=http://localhost:5173


# ── LLM providers ────────────────────────────────────────────────────────────
# OpenAI — REQUIRED. Several modules create the OpenAI client at import time,
# so the API will not start without it. Powers personas, interviews, survey
# simulation and embeddings.
OPENAI_API_KEY=sk-...

# Anthropic — Decision Intelligence / Behaviour Archaeology reports.
ANTHROPIC_API_KEY=

# Google Gemini — artifact (stimulus) dissection.
GEMINI_API_KEY=

# Model names. Artifact models must match the _MODEL_RATES keys in
# app/services/llm_usage_tracker.py or cost tracking records NULL.
# SURVEY_SIMULATION_MODEL=gpt-4o-mini
# ARTIFACT_DISSECTION_MODEL=gemini-2.5-flash
# ARTIFACT_REASONING_MODEL=gpt-4o-mini
# ARTIFACT_PERSONA_CONCURRENCY=5

# Report LLM timeouts (seconds).
# REPORT_LLM_TIMEOUT_SECONDS=900
# QUANT_REPORT_LLM_TIMEOUT_SECONDS=900
# QUAL_REPORT_PENDING_STALE_SECONDS=1800


# ── RAG / Knowledge Engine (Qdrant) ──────────────────────────────────────────
# Not needed to boot, but evidence sources, the sourcebank and report grounding
# need it. The ingestion worker logs and retries if Qdrant is unreachable.
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_COLLECTION_NAME=syntera-behavioral-summaries
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBED_BATCH_SIZE=100
# UPSERT_BATCH_SIZE=50
# TOP_K_RESULTS=5
# INGEST_POLL_INTERVAL_SECONDS=60
# Further KE_* tuning knobs (evidence thresholds, query intents) are documented
# in app/config.py.


# ── Plans and limits ─────────────────────────────────────────────────────────
# TIER1_EXPLORATION_LIMIT=3
# ENTERPRISE_EXPLORATION_LIMIT=10

# Discussion guide size caps (drive interview cost directly).
# DG_DEFAULT_QUESTIONS_PER_SECTION=4
# DG_MAX_EXTRA_QUESTIONS_PER_SECTION=2
# DG_MAX_SECTIONS_PER_GUIDE=8


# ── Neuroscience layer ───────────────────────────────────────────────────────
# Fallback only; the neuro_flag row in the database wins when present.
# NEURO_MODE_DEFAULT=false


# ── SyncDB web scraper (optional) ────────────────────────────────────────────
# Full list of SYNCDB_* knobs: app/services/syncdb_scraper.py.
# SYNCDB_ENABLE_DYNAMIC_SCRAPING=true
# Use an installed browser instead of Playwright's bundled Chromium:
# SYNCDB_PLAYWRIGHT_BROWSER_CHANNEL=msedge
# SYNCDB_PLAYWRIGHT_EXECUTABLE_PATH=
# Comma-separated domain lists:
# SYNCDB_STATIC_DOMAINS=
# SYNCDB_BLOCKED_DOMAINS=


# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO


# ── Deployed environments only — leave unset locally ─────────────────────────
# When SSM_PATH is set, every parameter under that AWS SSM path is loaded into
# the environment at startup (explicit env vars still win). Kubernetes sets
# these; see k8sdeployment/*/deployment.yml.
# SSM_PATH=/app/staging/
# AWS_REGION=ap-south-1


# ── Tests ────────────────────────────────────────────────────────────────────
# Server used by tests/test_migrations.py to create and drop scratch databases.
# MIGRATION_TEST_ADMIN_URL=postgresql://synth_user:synth_pass@localhost:5432/postgres
